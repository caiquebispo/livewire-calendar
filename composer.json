{
    "name": "caiquebispo/livewire-calendar",
    "description": "A lightweight, customizable Calendar component for Laravel Livewire with TailwindCSS.",
    "keywords": [
        "laravel",
        "livewire",
        "calendar",
        "livewire calendar",
        "laravel calendar",
        "blade calendar",
        "tailwind",
        "tailwindcss",
        "event calendar",
        "events",
        "component"
    ],
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "CaiqueBispo\\Calendar\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Caique Bispo",
            "email": "caiquebispo0023@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "livewire/livewire": "^3.5.0|^4.0.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "CaiqueBispo\\Calendar\\Provider\\CalendarServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}